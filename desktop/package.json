{
  "name": "pearwall-desktop",
  "private": true,
  "version": "0.1.2",
  "scripts": {
    "tauri": "node scripts/tauri-runner.mjs",
    "dev:frontend": "vite --config ui/vite.config.mts",
    "dev:installer-frontend": "vite --mode installer --config ui/vite.config.mts",
    "generate:licenses": "node scripts/generate-licenses.mjs",
    "build:settings": "pnpm generate:licenses && vite build --config ui/vite.config.mts",
    "build:installer-ui": "vite build --mode installer --config ui/vite.config.mts",
    "build:installer-frontend": "pnpm build:installer-ui && node scripts/build-installer-frontend.mjs",
    "build:frontend": "pnpm build:settings && node scripts/build-frontend.mjs",
    "build:macos-mediaremote": "zsh scripts/build-macos-mediaremote.sh",
    "build:macos-app": "zsh scripts/build-macos-app.sh",
    "build:macos-saver": "zsh scripts/build-macos-saver.sh",
    "build:windows-scr": "node scripts/build-windows-scr.mjs",
    "build:windows-installer": "node scripts/build-windows-installer.mjs",
    "build:dmg": "zsh scripts/build-dmg.sh",
    "build:screen-savers:check": "node scripts/build-screen-savers.mjs --check",
    "build:screen-savers": "node scripts/build-screen-savers.mjs",
    "version:check": "node scripts/version.mjs --check",
    "version:set": "node scripts/version.mjs --set",
    "dev": "pnpm tauri dev",
    "build": "pnpm tauri build"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@heroui/react": "^3.2.4",
    "@heroui/styles": "^3.2.4",
    "@lisse/react": "^0.7.2",
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "overlayscrollbars": "^2.16.0",
    "overlayscrollbars-react": "^0.5.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-progressive-blur": "^1.0.6",
    "vaul": "^1.1.2"
  }
}

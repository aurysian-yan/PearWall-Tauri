{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pear Wall",
  "version": "0.1.0",
  "identifier": "com.nevoit.pearwall.desktop",
  "build": {
    "beforeBuildCommand": "pnpm build:frontend",
    "beforeDevCommand": "pnpm build:frontend",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Pear Wall",
        "width": 1280,
        "height": 800,
        "fullscreen": false,
        "decorations": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "infoPlist": "Info.plist"
    },
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"]
  }
}

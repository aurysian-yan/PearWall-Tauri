{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pear Wall",
  "mainBinaryName": "pearwall-desktop",
  "version": "0.1.2",
  "identifier": "com.nevoit.pearwall.desktop",
  "build": {
    "beforeBuildCommand": "pnpm build:frontend",
    "beforeDevCommand": "pnpm dev:frontend",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Pear Wall",
        "url": "settings.html",
        "width": 1280,
        "height": 800,
        "minWidth": 400,
        "minHeight": 640,
        "fullscreen": false,
        "decorations": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "acceptFirstMouse": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../wallpaper-engine/assets/default_artwork.svg": "assets/default_artwork.svg",
      "../../wallpaper-engine/assets/moru": "assets/moru",
      "../../wallpaper-engine/src/presets.js": "assets/presets.json"
    },
    "macOS": {
      "minimumSystemVersion": "15.0",
      "infoPlist": "Info.macos.plist",
      "files": {
        "Resources/Assets.car": "resources/Assets.car",
        "Resources/mediaremote/PearWallMediaRemote.dylib": "resources/mediaremote/PearWallMediaRemote.dylib"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
